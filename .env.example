# Shell configuration template; never put real credentials in this file.
BOT_TOKEN_FILE=/path/to/private/bot_token.txt
LITELLM_API_KEY=replace_with_local_gateway_key
GATEWAY_BASE_URL=https://gw.o4.fdds.uk/v1
# Set to your numeric private Telegram chat ID to enable live polling.
TELEGRAM_OWNER_CHAT_ID=
# Set to 1 only when testing with synthetic messages.
ENABLE_TEST_INJECT=0
